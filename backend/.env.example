# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# Matches docker-compose.yml
DATABASE_URL="postgresql://market:market123@localhost:5432/marketplace"
REDIS_URL="redis://localhost:6379"
ELASTIC_URL="http://localhost:9200"

# Use a long random string (at least 32 characters)
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# Image storage: "local" (development) or "s3" (production)
STORAGE="local"
APP_URL="http://localhost:5000"

# Only needed when STORAGE="s3"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""

# Razorpay TEST keys (dashboard, Test Mode, API Keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional
# SEARCH_CACHE=off        turns the Redis search cache off (for benchmarks)
# ADMIN_PASSWORD=         password used by the seed script for admin@market.com
